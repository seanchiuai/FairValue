# Backend
PORT=8000

# Frontend local development. The Vite dev server uses this to open realtime
# sockets directly to the backend when it runs on a different port.
VITE_BACKEND_PORT=8000
VITE_WS_BASE_URL=

# Neon Postgres. Leave unset for local degraded mode where database-backed routes
# return DB errors but multiplayer room state can still run in memory.
DATABASE_URL=

# Durable multiplayer room snapshots. The real server process defaults to local
# JSON at .fairvalue/rooms.json. Set FAIRVALUE_ROOM_STORE=postgres to use the
# Neon/Postgres fairvalue_room_snapshots table when DATABASE_URL is configured.
FAIRVALUE_ROOM_STORE=json
FAIRVALUE_ROOM_STORE_PATH=
# Append-only room event stream. Defaults to a local
# FAIRVALUE_ROOM_STORE_PATH + ".events.ndjson" journal for JSON room
# persistence and to the fairvalue_room_events table for Postgres persistence.
FAIRVALUE_ROOM_EVENT_LOG=auto
# Development-only JSON override for the append-only event journal. Do not set
# this in production with FAIRVALUE_ROOM_STORE=postgres.
FAIRVALUE_ROOM_EVENT_LOG_PATH=
FAIRVALUE_ROOM_PERSISTENCE=on
FAIRVALUE_ROOM_RETENTION_DAYS=30
# Optional local JSON snapshot encryption. Set a stable private secret before
# rooms are created; losing it makes encrypted local snapshots unreadable.
FAIRVALUE_ROOM_SNAPSHOT_SECRET=
# Optional Postgres snapshot retention. Disabled by default to avoid deleting
# production rows until an operator chooses the policy.
FAIRVALUE_POSTGRES_ROOM_RETENTION_DAYS=0
# Optional live database readiness checks. Leave write smoke off unless you want
# to create/read/delete one temporary FV-prefixed room row in DATABASE_URL.
FAIRVALUE_LIVE_POSTGRES_SMOKE=0
FAIRVALUE_REQUIRE_DATABASE_URL=0
FAIRVALUE_LIVE_POSTGRES_DRIVER=

# Optional operations token for /api/ops/metrics. Local development allows the
# metrics endpoint without a token; production requires this to be set.
FAIRVALUE_OPS_TOKEN=

# Signs anonymous browser identities for durable user/host authority. Set a
# stable, private value in shared or deployed environments.
FAIRVALUE_IDENTITY_SECRET=
# Optional private JSON store for signed-in user reputation. The real server
# process defaults to .fairvalue/user-reputation.json when unset. Do not expose
# this file publicly.
FAIRVALUE_USER_REPUTATION_PATH=
# Optional private JSON store for signed-in user profile state: watchlists,
# notes, and saved price thresholds. The real server process defaults to
# .fairvalue/user-profile.json when unset. Do not expose this file publicly.
FAIRVALUE_USER_PROFILE_PATH=
# Optional server-side webhook for private threshold alert delivery. When unset,
# alerts remain in-app only. The webhook URL must use https outside localhost.
FAIRVALUE_ALERT_WEBHOOK_URL=
# Optional HMAC secret for alert webhook payload signatures. Keep server-side.
FAIRVALUE_ALERT_WEBHOOK_SECRET=
# Optional static property snapshot path used by private alert evaluation and
# future server-side property query surfaces. Defaults to public/data/properties.json.
FAIRVALUE_PROPERTY_SNAPSHOT_PATH=
# Optional HMAC signing secret for public settled-room verification artifacts.
# If unset, the endpoint returns deterministic unsigned local digests.
FAIRVALUE_PUBLIC_VERIFICATION_SECRET=

# Cognee AI. Keep this server-side only. Never expose it as VITE_*.
COGNEE_API_KEY=
COGNEE_BASE_URL=https://api.cognee.ai
