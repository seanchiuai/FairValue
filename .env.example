# Backend
PORT=8000

# Frontend local development. The React dev server uses this to open realtime
# sockets directly to the backend when it runs on a different port.
REACT_APP_BACKEND_PORT=8000
REACT_APP_WS_BASE_URL=

# Neon Postgres. Leave unset for local degraded mode where database-backed routes
# return DB errors but multiplayer room state can still run in memory.
DATABASE_URL=

# Durable multiplayer room snapshots. The real server process defaults to
# .fairvalue/rooms.json; set this to move it, or set FAIRVALUE_ROOM_PERSISTENCE=off
# to force fully ephemeral room state.
FAIRVALUE_ROOM_STORE_PATH=
FAIRVALUE_ROOM_PERSISTENCE=on

# Cognee AI. Keep this server-side only. Never expose it as REACT_APP_*.
COGNEE_API_KEY=
COGNEE_BASE_URL=https://api.cognee.ai
