{
  "name": "mission-betting",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^0.563.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0",
    "ws": "^8.19.0"
  },
  "scripts": {
    "server": "node server/index.js",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "rm -f /tmp/fairvalue-e2e-rooms.json && FAIRVALUE_ROOM_STORE_PATH=/tmp/fairvalue-e2e-rooms.json E2E_REUSE_EXISTING=false E2E_BACKEND_PORT=8010 E2E_FRONTEND_PORT=3010 playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:server": "node --test server/__tests__/*.test.js",
    "scan:secrets": "node scripts/scan-client-secrets.js",
    "verify": "npm run scan:secrets && npm run test:server && npm test -- --watchAll=false && npm run build",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/production/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/production/dom-export.js",
      "^react-router/internal$": "<rootDir>/node_modules/react-router/dist/production/index.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "yaml": "^2.8.4"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "bfj": "9.1.3",
    "nth-check": "3.0.1",
    "postcss": "8.5.14",
    "serialize-javascript": "7.0.5",
    "underscore": "1.13.8"
  }
}
